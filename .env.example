# PostgreSQL
DATABASE_URL=postgres://egp:egp_pass@postgres:5432/egp_exchange

# Redis
REDIS_URL=redis://redis:6379

# JWT Secret (change in production!)
JWT_SECRET=super-secret-key-change-me-in-production

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Binance WebSocket (default)
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Admin bootstrap credentials
ADMIN_EMAIL=admin@egp.exchange
ADMIN_PASSWORD=admin123

# PostgreSQL credentials (for docker-compose)
POSTGRES_USER=egp
POSTGRES_PASSWORD=egp_pass
POSTGRES_DB=egp_exchange
